VITE_API_URL=http://localhost:10000/api

# API/server variables (configure these on the Render API service, not in the static frontend)
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:10000

# Optional password-reset email configuration (Gmail requires a 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-school-gmail@example.com
SMTP_PASS=replace-with-gmail-app-password
SMTP_FROM=School Results Portal <your-school-gmail@example.com>
APP_URL=http://localhost:5173
