VITE_API_URL=http://localhost:10000/api

# API/server variables (configure these on the Render API service, not in the static frontend)
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 upload storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=school-result-portal
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_PUBLIC_BASE_URL=https://cdn.example.com
